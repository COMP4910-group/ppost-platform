{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "@ppost/plan-document": "*"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prestart": "npm run build --prefix ../plan-document",
    "prebuild": "npm run build --prefix ../plan-document",
    "pretest": "npm run build --prefix ../plan-document",
    "postbuild": "node -e \"const fs=require('fs'),d='build/static/media',bad=fs.existsSync(d)?fs.readdirSync(d).filter(f=>f.endsWith('.cjs')):[];if(bad.length){console.error('CommonJS module emitted as a static file instead of bundled: '+bad.join(', '));process.exit(1)}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "react-router/dist/development/dom-export.js"
    }
  }
}
